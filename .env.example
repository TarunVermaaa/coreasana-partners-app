# Base URL of the Core Asana Partners API (the partners-api repo).
# Local dev on a simulator/web: http://localhost:4100
# Android phone on the same Wi-Fi: http://<your-computer-LAN-IP>:4100
# Production build: the deployed API URL, e.g. https://partners-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:4100

# Development only: serve typed fixture data instead of calling the API (1 = on).
EXPO_PUBLIC_USE_FIXTURES=0
